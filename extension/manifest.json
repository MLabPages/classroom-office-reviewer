{
  "manifest_version": 3,
  "name": "Classroom Office Reviewer",
  "description": "Google Classroom の Word／PowerPoint／Google形式の提出物をPDF表示し、全画面発表にも対応します。",
  "key": "",
  "version": "0.9.5",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://docs.google.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Classroom Office Reviewer"
  },
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*",
        "https://drive.google.com/*",
        "https://docs.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "submission-list.js",
        "bulk-zip.html",
        "bulk-zip.js",
        "bulk-zip-core.js",
        "zip-writer.js",
        "vendor/pdf.mjs",
        "vendor/pdf.worker.mjs"
      ],
      "matches": [
        "https://classroom.google.com/*"
      ]
    }
  ]
}
